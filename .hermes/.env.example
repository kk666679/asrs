# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme
DATABASE_URL=postgresql://asrs:<POSTGRES_PASSWORD>@localhost:5432/asrs_db
POSTGRES_USER=asrs
POSTGRES_PASSWORD=<set-a-strong-password>
POSTGRES_DB=asrs_db

# ── Model Providers ───────────────────────────────────────────────────────────
HERMES_MODEL_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Hermes Runtime ────────────────────────────────────────────────────────────
HERMES_HOME=~/.hermes
HERMES_LOG_LEVEL=info
HERMES_TELEMETRY=true
HERMES_MCP_ENABLED=false
# Comma-separated allowlist for internal URL validation (SSRF protection)
HERMES_ALLOWED_HOSTS=localhost,127.0.0.1,redis,postgres

# ── AGV / Hardware ────────────────────────────────────────────────────────────
AGV_API_URL=
AGV_API_KEY=

# ── Vision / Quality Inspection ───────────────────────────────────────────────
VISION_API_URL=
VISION_ALLOWED_HOSTS=localhost,127.0.0.1,minio,storage

# ── Gateways ──────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_TOKEN=
SMTP_HOST=

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
